# Crontab for em-ebay-repricer (parallel plan per tier + separate apply).
#
# Does not replace legacy em-celery `spree_ebay_repricing.sh` — run alongside.
#
# VPS wrapper: install scripts/em_ebay_repricer.vps.sh → /home/Admin/scripts/em_ebay_repricer.sh
#
# Locks — non-blocking flock; if still held, cron tick skips (exit 0):
#   plan:  ~/.em_celery/locks/ebay_repricer_plan_{cart,ads,catalog}.lock
#   apply: ~/.em_celery/locks/ebay_repricer_apply.lock
#
# Logs:  /data/logs/ebay_repricer_*.log
#   (/data is a bind mount of /tmp/persistent on the sdb1 volume; survives /tmp cleanup)
# Logrotate (VPS): sudo cp scripts/logrotate.ebay_repricer /etc/logrotate.d/em_data_logs
#   (or use the unified /etc/logrotate.d/em_data_logs covering /data/logs/*.log)
#
# Schedule (server local time) — every 4h; three plans start together; apply independent:

SHELL=/bin/bash
PATH=/home/Admin/.local/bin:/usr/local/bin:/usr/bin:/bin
HOME=/home/Admin

20 */4 * * * /home/Admin/scripts/em_ebay_repricer.sh plan cart >> /data/logs/ebay_repricer_plan_cart.log 2>&1
20 */4 * * * /home/Admin/scripts/em_ebay_repricer.sh plan ads >> /data/logs/ebay_repricer_plan_ads.log 2>&1
20 */4 * * * /home/Admin/scripts/em_ebay_repricer.sh plan catalog >> /data/logs/ebay_repricer_plan_catalog.log 2>&1
50 */4 * * * /home/Admin/scripts/em_ebay_repricer.sh apply >> /data/logs/ebay_repricer_apply.log 2>&1

# Deprecated (sequential plan then apply under one lock):
# 20 */4 * * * /home/Admin/scripts/em_ebay_repricer.sh plan-apply >> /data/logs/ebay_repricer_plan_apply.log 2>&1
