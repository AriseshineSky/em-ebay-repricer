# Keep ~2 days of em-ebay-repricer cron logs under /tmp (separate disk).
# Install on VPS:
#   sudo cp scripts/logrotate.ebay_repricer /etc/logrotate.d/ebay_repricer
# copytruncate: safe with cron ">> file 2>&1" appenders.
# su: required because /tmp is world-writable.
/tmp/ebay_repricer_*.log
{
    daily
    rotate 2
    maxage 2
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
    dateext
    dateformat -%Y%m%d
    su Admin Admin
}
